{
    "name": "@dhis2-chap/ui",
    "packageManager": "pnpm@10.14.0",
    "type": "commonjs",
    "version": "7.3.1",
    "module": "./build/es/index.js",
    "types": "./build/types/index.d.ts",
    "license": "MIT",
    "scripts": {
        "watch": "tsc --watch",
        "build": "d2-app-scripts build && tsc --emitDeclarationOnly --outDir ./build/types",
        "start": "concurrently -n build,types --hide types \"d2-app-scripts build --watch\" \"tsc --emitDeclarationOnly --outDir ./build/types --watch\"",
        "linter:check": "eslint . --config ../../eslint.config.mts",
        "deploy": "d2-app-scripts deploy",
        "generate": "openapi --input http://localhost:8000/openapi.json --output ./src/httpfunctions --request ./src/queuedRequest.ts",
        "tsc:check": "tsc --noEmit"
    },
    "main": "./build/cjs/index.js",
    "exports": {
        ".": {
            "import": "./build/es/index.js",
            "require": "./build/cjs/index.js",
            "types": "./build/types/index.d.ts"
        }
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "@dhis2/app-runtime": "^3.14.6",
        "@tanstack/react-query": "4"
    },
    "dependencies": {
        "@dhis2-chap/core": "workspace:*",
        "@dhis2/d2-i18n": "1.2.0",
        "@dhis2/maps-gl": "^4.1.2",
        "@dhis2/multi-calendar-dates": "^2.1.2",
        "@dhis2/ui": "^10.13.0",
        "@hookform/resolvers": "^5.0.1",
        "classnames": "^2.5.1",
        "date-fns": "^4.1.0",
        "highcharts": "11.4.8",
        "highcharts-react-official": "^3.2.1",
        "p-queue": "^8.1.0",
        "react-hook-form": "^7.51.5",
        "react-virtuoso": "^4.6.2",
        "styled-jsx": "^4.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@dhis2/app-runtime": "3.14.6",
        "@dhis2/cli-app-scripts": "12.11.1",
        "@tanstack/react-query": "4",
        "@types/css-modules": "^1.0.5",
        "@types/highcharts": "^5.0.44",
        "@types/node": "^22.10.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.0",
        "openapi-typescript-codegen": "^0.29.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.7.2"
    }
}
